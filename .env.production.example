# Скопируйте в .env на сервере и заполните. Файл .env не коммитится.

# База данных (наружу не открыта, пароль всё равно сделайте длинным)
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=

# Первый администратор CRM — используется, только пока в базе нет пользователей
CRM_ADMIN_LOGIN=admin
CRM_ADMIN_PASSWORD=

# Токен бота-секретаря из @BotFather
TELEGRAM_BOT_TOKEN=

# Часовой пояс для дашборда и фильтров по датам
CRM_TIMEZONE=Europe/Moscow

# Где слушает сайт. Без nginx на сервере: 0.0.0.0 и 80.
# За nginx сервера: HTTP_BIND=127.0.0.1, HTTP_PORT=8080 (снаружи контейнер не виден)
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# Лимит памяти бекенда
BACKEND_MEMORY=640m
